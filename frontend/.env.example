# Development only; production builds reject true. No provider keys belong here.
VITE_USE_FIXTURES=false

# Optional licensed MapLibre style URLs. Leave blank for a truthful geometry-only map.
# Both themes must be configured to avoid mismatched day/night basemaps.
# Public browser keys only; apply provider origin restrictions and supply attribution in the style.
VITE_MAP_STYLE_DAY=
VITE_MAP_STYLE_NIGHT=
