# Copy only if .env.production does not exist. Supply unique secrets privately; never commit it.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=routecast.example.com
POSTGRES_DB=routecast
POSTGRES_USER=routecast
POSTGRES_PASSWORD=
TOMTOM_API_KEY=
# Start in controlled mode: no periodic scheduling. Explicit trip jobs still call providers.
ROUTECAST_LIVE_TEST_MODE=true
REFRESH_SECONDS=900
VIEWER_EXPIRY_SECONDS=1800
MANUAL_COOLDOWN_SECONDS=60
CORRIDOR_WIDTH_MILES=10
GATEWAY_PORT=8080
RELEASE_TAG=local
VITE_MAP_STYLE_DAY=
VITE_MAP_STYLE_NIGHT=
# For a chosen release, replace defaults with approved immutable image digests.
PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:24-alpine
NGINX_IMAGE=nginx:stable-alpine
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
