DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-only-replace-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
POSTGRES_DB=routecast
POSTGRES_USER=routecast
POSTGRES_PASSWORD=routecast-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# Provider credentials/configuration are added when their integration phase is requested.

# Server-side only. Never put this key in frontend configuration.
TOMTOM_API_KEY=

# Shared hard budgets: zero blocks; no unlimited setting. See docs/API_USAGE_LIMITS.md.
TOMTOM_LIMIT_MINUTE=20
TOMTOM_LIMIT_HOUR=100
TOMTOM_LIMIT_DAY=100
TOMTOM_LIMIT_MONTH=2000
OPEN_METEO_LIMIT_MINUTE=200
OPEN_METEO_LIMIT_HOUR=1000
OPEN_METEO_LIMIT_DAY=4000
OPEN_METEO_LIMIT_MONTH=100000

# Disables periodic scheduling (explicitly queued analyses still run in workers).
ROUTECAST_LIVE_TEST_MODE=false
REFRESH_SECONDS=900
VIEWER_EXPIRY_SECONDS=1800
MANUAL_COOLDOWN_SECONDS=60

# Visualization corridor half-width; checkpoint risk sampling is independent.
CORRIDOR_WIDTH_MILES=10
